# =============================================================================
# Telegram Download Bot - Environment Variables & Cloudflare Configuration
# =============================================================================
#
# NOTE: In Cloudflare Workers, sensitive values (such as BOT_TOKEN and WEBHOOK_SECRET)
# should NEVER be placed in public files or source control.
# Use Wrangler secrets:
#   npx wrangler secret put BOT_TOKEN
#   npx wrangler secret put WEBHOOK_SECRET
#
# Non-sensitive variables can be configured in wrangler.jsonc under "vars".
# =============================================================================

# --- Telegram Bot Secrets ---
# Bot token received from @BotFather (Cloudflare Secret: npx wrangler secret put BOT_TOKEN)
BOT_TOKEN=your_telegram_bot_token_here

# Secret token used to authenticate Telegram webhooks via X-Telegram-Bot-Api-Secret-Token
# (Cloudflare Secret: npx wrangler secret put WEBHOOK_SECRET)
WEBHOOK_SECRET=your_random_webhook_secret_here

# --- Channel / YouTube Configuration ---
# Fallback channel identifier (e.g., @freat_editz or -1001234567890)
CHANNEL=@freat_editz

# YouTube channel URL for user verification
YOUTUBE=https://youtube.com/@freat_editz

# Telegram channel invitation / direct link
CHANNEL_LINK=https://t.me/freat_editz

# --- Database Configuration ---
# For local development with SQLite (Prisma):
DATABASE_URL=file:./backend/prisma/dev.db

# For Cloudflare Workers, database is bound via D1 (binding "DB" in wrangler.jsonc).
# No connection string is required in Workers.

# --- Backend Server (Local Node.js Development) ---
BACKEND_PORT=3000
NODE_ENV=development

# --- CORS & Frontend Configuration ---
# Optional backend base URL override (in Cloudflare Workers, defaults to worker origin)
BACKEND_BASE_URL=

# Comma-separated list of allowed origins for the dashboard
CORS_ORIGINS=https://telegram-bot-22xi.vercel.app

# Optional single frontend URL
FRONTEND_URL=

# --- Security Notice ---
# A Supabase DATABASE_URL credential previously present in this file must be rotated
# immediately in the Supabase management console if still active.
