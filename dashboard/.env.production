# =============================================================================
#  Production overrides for Cloudflare deployment
#
#  When served alongside the Worker backend on Cloudflare, `/api` is relative
#  to the current origin, eliminating CORS overhead.
#  If hosting dashboard on a separate domain (e.g., Vercel), replace `/api`
#  with your Worker API base URL: `https://<your-worker>.workers.dev/api`.
# =============================================================================

VITE_API_BASE_URL=/api
VITE_API_URL=/api

VITE_APP_NAME=Admin Dashboard

VITE_BOT_USERNAME=FreatEditzResources_Bot
