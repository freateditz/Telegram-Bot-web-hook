# =============================================================================
# Backend Environment Configuration (.env)
# =============================================================================

# --- Server (Local Node.js Development) ---
BACKEND_PORT=3000
NODE_ENV=development

# --- Database ---
# Local SQLite for Prisma CLI and development:
DATABASE_URL=file:./backend/prisma/dev.db

# --- Telegram Bot Secrets ---
# In production Cloudflare Workers, set via: npx wrangler secret put BOT_TOKEN
BOT_TOKEN=your_telegram_bot_token_here

# Secret token for X-Telegram-Bot-Api-Secret-Token webhook validation:
WEBHOOK_SECRET=your_random_webhook_secret_here

# --- Channel & Verification Links ---
CHANNEL=@freat_editz
YOUTUBE=https://youtube.com/@freat_editz
CHANNEL_LINK=https://t.me/freat_editz

# --- CORS & Base URLs ---
# In Cloudflare Workers, backend URL defaults automatically to the Worker origin.
BACKEND_BASE_URL=
FRONTEND_URL=
CORS_ORIGINS=https://telegram-bot-22xi.vercel.app
